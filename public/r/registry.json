    {
      "name": "sound-engine",
      "type": "registry:lib",
      "title": "RenderJoy Sound & Haptic Engine",
      "description": "Zero-asset Web Audio API synthesizer and navigator.vibrate feedback store (off by default).",
      "files": [
        {
          "path": "lib/audio/sound-engine.ts",
          "type": "registry:lib",
          "target": "lib/audio/sound-engine.ts"
        },
        {
          "path": "lib/audio/feedback-store.ts",
          "type": "registry:lib",
          "target": "lib/audio/feedback-store.ts"
        },
        {
          "path": "lib/audio/use-sound.ts",
          "type": "registry:lib",
          "target": "lib/audio/use-sound.ts"
        }
      ]
    },
    {
      "name": "bounce-dots-loader",
      "type": "registry:component",
      "title": "Bounce Dots Loader",
      "description": "Lightweight CSS-keyframe three-dot loader with wave, elastic, and pulse rhythm presets.",
      "dependencies": [
        "clsx",
        "tailwind-merge"
      ],
      "files": [
        {
          "path": "registry/components/bounce-dots-loader.tsx",
          "type": "registry:component",
          "target": "components/renderjoy/bounce-dots-loader.tsx"
        }
      ],
      "css": {
        "@keyframes mm-bounce-dot": {
          "0%, 80%, 100%": {
            "transform": "translateY(0)",
            "opacity": "0.45"
          },
          "40%": {
            "transform": "translateY(-6px)",
            "opacity": "1"
          }
        }
      }
    },
    {
      "name": "wiggle-text",
      "type": "registry:component",
      "title": "Wiggle Text",
      "description": "Lightweight CSS-animated character or word wiggle typography primitive with configurable intensity and trigger.",
      "dependencies": [
        "clsx",
        "tailwind-merge"
      ],
      "files": [
        {
          "path": "registry/components/wiggle-text.tsx",
          "type": "registry:component",
          "target": "components/renderjoy/wiggle-text.tsx"
        }
      ],
      "css": {
        "@keyframes mm-wiggle": {
          "0%, 100%": {
            "transform": "translateY(0) rotate(0deg)"
          },
          "25%": {
            "transform": "translateY(var(--mm-wiggle-y, -3px)) rotate(calc(var(--mm-wiggle-rot, 6deg) * -1))"
          },
          "50%": {
            "transform": "translateY(calc(var(--mm-wiggle-y, -3px) * 0.5)) rotate(var(--mm-wiggle-rot, 6deg))"
          },
          "75%": {
            "transform": "translateY(calc(var(--mm-wiggle-y, -3px) * 0.25)) rotate(calc(var(--mm-wiggle-rot, 6deg) * -0.5))"
          }
        }
      }
    },
